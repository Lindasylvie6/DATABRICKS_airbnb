{
  "datasets": [
    {
      "name": "bookings",
      "displayName": "Bookings",
      "config": {
        "version": "1.1",
        "source": "airbnb_obs.gold.fact_bookings",
        "dimensions": [
          {
            "name": "booking_id",
            "expr": "booking_id"
          },
          {
            "name": "listing_id",
            "expr": "listing_id"
          },
          {
            "name": "booking_date",
            "expr": "booking_date"
          },
          {
            "name": "booking_status",
            "expr": "booking_status"
          }
        ],
        "measures": [
          {
            "name": "revenue",
            "expr": "SUM(booking_amount)"
          },
          {
            "name": "booking_count",
            "expr": "COUNT(booking_id)"
          },
          {
            "name": "cancelled_bookings",
            "expr": "COUNT(CASE WHEN LOWER(booking_status) IN ('cancelled', 'canceled') THEN booking_id END)"
          },
          {
            "name": "total_bookings",
            "expr": "COUNT(booking_id)"
          }
        ]
      }
    },
    {
      "name": "listings",
      "displayName": "Listings",
      "config": {
        "version": "1.1",
        "source": "airbnb_obs.gold.dim_listings",
        "dimensions": [
          {
            "name": "listing_id",
            "expr": "listing_id"
          },
          {
            "name": "property_type",
            "expr": "property_type"
          },
          {
            "name": "city",
            "expr": "city"
          },
          {
            "name": "country",
            "expr": "country"
          }
        ],
        "measures": [
          {
            "name": "listing_count",
            "expr": "COUNT(listing_id)"
          }
        ]
      }
    },
    {
      "name": "booking_analysis",
      "displayName": "Booking Analysis",
      "config": {
        "version": "1.1",
        "source": "SELECT \n  b.booking_id,\n  b.listing_id,\n  b.booking_date,\n  b.booking_status,\n  b.nights_booked,\n  b.booking_amount,\n  b.cleaning_fee,\n  b.service_fee,\n  l.property_type,\n  l.city,\n  l.country,\n  l.host_id\nFROM airbnb_obs.gold.fact_bookings b INNER JOIN airbnb_obs.gold.dim_listings l ON b.listing_id = l.listing_id\n",
        "dimensions": [
          {
            "name": "booking_id",
            "expr": "booking_id"
          },
          {
            "name": "booking_date",
            "expr": "booking_date"
          },
          {
            "name": "booking_status",
            "expr": "booking_status"
          },
          {
            "name": "property_type",
            "expr": "property_type"
          },
          {
            "name": "city",
            "expr": "city"
          },
          {
            "name": "country",
            "expr": "country"
          }
        ],
        "measures": [
          {
            "name": "total_revenue",
            "expr": "SUM(booking_amount)"
          },
          {
            "name": "total_bookings",
            "expr": "COUNT(booking_id)"
          },
          {
            "name": "cancelled_bookings",
            "expr": "COUNT(CASE WHEN LOWER(booking_status) IN ('cancelled', 'canceled') THEN booking_id END)"
          },
          {
            "name": "cancellation_rate",
            "expr": "COUNT(CASE WHEN LOWER(booking_status) IN ('cancelled', 'canceled') THEN booking_id END) * 100.0 / COUNT(booking_id)"
          }
        ]
      }
    },
    {
      "name": "top_10_cities",
      "displayName": "Top 10 Cities by Revenue",
      "config": {
        "version": "1.1",
        "source": "SELECT \n  l.city,\n  SUM(b.booking_amount) as total_revenue\nFROM airbnb_obs.gold.fact_bookings b INNER JOIN airbnb_obs.gold.dim_listings l ON b.listing_id = l.listing_id GROUP BY l.city ORDER BY total_revenue DESC LIMIT 10\n",
        "dimensions": [
          {
            "name": "city",
            "expr": "city"
          }
        ],
        "measures": [
          {
            "name": "total_revenue",
            "expr": "SUM(total_revenue)"
          }
        ]
      }
    }
  ],
  "relationshipGraphs": [
    {
      "sources": [
        {
          "name": "Bookings",
