{
  "datasets": [
    {
      "name": "airbnb_analytics",
      "displayName": "Airbnb Analytics",
      "config": {
        "version": "1.1",
        "source": "SELECT\n  b.booking_id,\n  b.booking_date,\n  b.booking_status,\n  b.nights_booked,\n  b.booking_amount,\n  b.cleaning_fee,\n  b.service_fee,\n  b.booking_amount + b.cleaning_fee + b.service_fee AS total_revenue,\n  l.listing_id,\n  l.property_type,\n  l.city,\n  l.country,\n  l.accommodates,\n  l.bedrooms,\n  l.bathrooms,\n  l.price_per_night,\n  h.host_id,\n  h.host_name,\n  h.is_superhost,\n  h.response_rate,\n  h.host_since,\n  YEAR(b.booking_date) AS booking_year,\n  MONTH(b.booking_date) AS booking_month,\n  DAYOFWEEK(b.booking_date) AS booking_day_of_week,\n  (ABS(HASH(l.city)) % 181 - 90.0) AS city_latitude,\n  (ABS(HASH(l.city)) % 361 - 180.0) AS city_longitude\nFROM airbnb_obs.gold.fact_bookings b INNER JOIN airbnb_obs.gold.dim_listings l ON b.listing_id = l.listing_id INNER JOIN airbnb_obs.gold.dim_hosts h ON l.host_id = h.host_id\n",
        "dimensions": [
          {
            "name": "booking_id",
            "expr": "booking_id"
          },
          {
            "name": "booking_date",
            "expr": "booking_date"
          },
          {
            "name": "booking_status",
            "expr": "booking_status"
          },
          {
            "name": "property_type",
            "expr": "property_type"
          },
          {
            "name": "city",
            "expr": "city"
          },
          {
            "name": "country",
            "expr": "country"
          },
          {
            "name": "host_name",
            "expr": "host_name"
          },
          {
            "name": "is_superhost",
            "expr": "is_superhost"
          },
          {
            "name": "booking_year",
            "expr": "booking_year"
          },
          {
            "name": "booking_month",
            "expr": "booking_month"
          },
          {
            "name": "accommodates",
            "expr": "accommodates"
          },
          {
            "name": "bedrooms",
            "expr": "bedrooms"
          },
          {
            "name": "city_latitude",
            "expr": "city_latitude"
          },
          {
            "name": "city_longitude",
            "expr": "city_longitude"
          }
        ],
        "measures": [
          {
            "name": "total_bookings",
            "expr": "COUNT(booking_id)"
          },
          {
            "name": "total_revenue",
            "expr": "SUM(total_revenue)"
          },
          {
            "name": "total_booking_amount",
            "expr": "SUM(booking_amount)"
          },
          {
            "name": "total_cleaning_fees",
            "expr": "SUM(cleaning_fee)"
          },
          {
            "name": "total_service_fees",
            "expr": "SUM(service_fee)"
          },
          {
            "name": "avg_booking_value",
            "expr": "AVG(total_revenue)"
          },
          {
            "name": "avg_nights_booked",
            "expr": "AVG(nights_booked)"
          },
          {
            "name": "confirmed_bookings",
            "expr": "SUM(CASE WHEN booking_status = 'confirmed' THEN 1 ELSE 0 END)"
          },
          {
            "name": "cancelled_bookings",
            "expr": "SUM(CASE WHEN booking_status = 'cancelled' THEN 1 ELSE 0 END)"
          },
          {
            "name": "cancellation_rate",
            "expr": "SUM(CASE WHEN booking_status = 'cancelled' THEN 1 ELSE 0 END) * 100.0 / COUNT(booking_id)"
          },
          {
            "name": "avg_price_per_night",
            "expr": "AVG(price_per_night)"
          },
          {
            "name": "unique_hosts",
            "expr": "COUNT(DISTINCT host_id)"
          },
          {
            "name": "unique_listings",
            "expr": "COUNT(DISTINCT listing_id)"
          }
        ]
      }
    }
  ],
